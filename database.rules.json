{
  "rules": {
    ".read": false,
    ".write": false,
    "active_ride_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$requestId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "hero_pings": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$heroId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$requestId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "active_service_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$requestId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "active_rides": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$rideId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "hero_service_pings": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$heroId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$requestId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "seller_pings": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$sellerId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$requestId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "online_heroes": {
      ".read": "auth != null",
      "$heroId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $heroId"
      }
    },
    "live_locations": {
      ".read": "auth != null",
      "$rideId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "dispute_reports": {
      ".read": "auth != null",
      "$reportId": {
        ".write": "auth != null"
      }
    },
    "hero_status_updates": {
      ".read": "auth != null",
      "$heroId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "sos_alerts": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "hero_precaution_pings": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$heroId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$requestId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "service_request_precaution_willing": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$requestId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$heroId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
