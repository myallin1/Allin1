<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>
    <uses-permission android:name="android.permission.WRITE_CALL_LOG"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.READ_SMS"/>
    <uses-permission android:name="android.permission.SEND_SMS"/>
    <!-- NEW (Aug 31 2026 — Option A, default-dialer role): required to
         hold RoleManager.ROLE_DIALER and to relay ACTION_DIAL taps to
         TelecomManager.placeCall() from ChittiDialerActivity. -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <!-- NEW (Sep 2 2026 — Nizam: dialer needs call history and contacts,
         "already namma record system" ). Read-only: this screen shows the
         same call log/contacts stock dialers do, it never writes them. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>

    <application>
        <!-- Chitti System-Wide Autonomous Assistant Service -->
        <service
            android:name=".ChittiAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Broadcast Receiver for Call screening state updates (Securely not exported) -->
        <receiver android:name=".CallReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- NEW (Aug 31 2026 — Option A): the real, permanent speaker-
             route fix. Only receives real calls once Chitti holds
             RoleManager.ROLE_DIALER (requested from Admin AI Settings) —
             see ChittiInCallService's own header for the full root-cause
             reasoning ("Chitti loud speaker on agala" on both Oppo and
             Lenovo). android:exported="true" + BIND_INCALL_SERVICE is
             the standard, required declaration for any InCallService;
             the permission itself restricts binding to the OS. -->
        <service
            android:name=".ChittiInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- NEW (Aug 31 2026 — Option A): required for a default-dialer
             app — handles a tap on a phone number from Contacts/Recents/
             anywhere else on the phone by relaying it straight to
             TelecomManager.placeCall(), so outgoing calling keeps
             working exactly as before once Chitti holds the Phone role.
             No visible UI (see ChittiDialerActivity's header). -->
        <activity
            android:name=".ChittiDialerActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- NEW (Aug 31 2026 — Option A): handles the Hang Up / Speaker
             buttons on the in-call notification (PhoneCallService.
             showInCallNotification) — the admin's manual controls now
             that Android no longer shows its own in-call screen for
             this app's calls. Not exported: only this app's own
             notification ever sends these actions. -->
        <receiver android:name=".ChittiCallNotificationActionReceiver" android:exported="false" />

        <!-- NEW (Sep 2 2026 — launcher "Dialer" shortcut). No-UI
             trampoline the shortcut targets — see
             AdminDialerShortcutActivity's header. -->
        <activity
            android:name=".AdminDialerShortcutActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- Adds the "android.app.shortcuts" declaration (xml/shortcuts.
             xml) AND the GitHub link filter below to the shared
             MainActivity — merged onto the declaration in the main
             manifest (standard Android flavor-source-set behaviour, same
             pattern the customer flavor uses for its own App Link — see
             src/customer/AndroidManifest.xml), not a second activity.

             MOVED HERE FROM src/main (Sep 5 2026 audit): the GitHub
             intent-filter was first added to the SHARED main manifest,
             which Gradle merges into every flavor — so the customer,
             hero and seller apps were all silently registering as
             handlers for https://github.com links despite having zero
             screen to show for one. Scoped to the admin flavor only, the
             one that actually has GitHubEmbeddedScreen / the browser
             tab. -->
        <activity android:name=".MainActivity">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- Nizam: a GitHub password-reset link tapped in Gmail
                 offered only Chrome and the system browser, because this
                 app declared no https filter at all. With this it
                 appears in that chooser and the reset finishes inside
                 the admin app, in the same WebView that already holds
                 the GitHub session.

                 SCOPED TO github.com ON PURPOSE, and this is the whole
                 design decision. A filter on https with no host would
                 also work, and would put this app in the chooser for
                 EVERY link he ever taps on his phone — a far worse
                 problem than the one being fixed. Not autoVerify either:
                 we do not own github.com, so App Links verification
                 would fail and the filter would be ignored. A chooser
                 entry is exactly what is wanted — it offers, it does not
                 take over. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="github.com"/>
                <data android:scheme="https" android:host="*.github.com"/>
            </intent-filter>
        </activity>

        <!-- Broadcast Receiver for incoming SMS messages -->
        <receiver android:name=".SmsReceiver" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Step 1 (Aug 30 2026) — registers Chitti as a selectable
             Default Digital Assistant app. android:exported="true" is
             required here: the system itself must be able to bind this
             service regardless of which app the user currently has set
             as their assistant, so it can be offered/selected in
             Settings > Apps > Default apps > Digital assistant app. The
             BIND_VOICE_INTERACTION permission is what actually restricts
             binding to the OS, not third-party apps. -->
        <service
            android:name=".ChittiVoiceInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>
        <service
            android:name=".ChittiVoiceInteractionSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />
        <service
            android:name=".ChittiRecognitionService"
            android:permission="android.permission.BIND_VOICE_RECOGNITION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
