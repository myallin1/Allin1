<?xml version="1.0" encoding="utf-8"?>
<!--
  Hero (hero allin1) launcher icon — redesigned to match the "classy,
  neat" flat rounded-square tile + simple white glyph style requested.
  Bike/two-wheeler glyph represents the delivery-hero app.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rounded-square tile, brand purple -->
    <path
        android:pathData="M32,18 H76 A14,14 0 0 1 90,32 V76 A14,14 0 0 1 76,90 H32 A14,14 0 0 1 18,76 V32 A14,14 0 0 1 32,18 Z"
        android:fillColor="#6C63FF" />

    <!-- Left wheel -->
    <path
        android:pathData="M52,72 A8,8 0 1 1 36,72 A8,8 0 1 1 52,72 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4" />

    <!-- Right wheel -->
    <path
        android:pathData="M76,72 A8,8 0 1 1 60,72 A8,8 0 1 1 76,72 Z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4" />

    <!-- Frame -->
    <path
        android:pathData="M44,72 L52,50 L62,50 L68,72"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Handlebar -->
    <path
        android:pathData="M52,50 L47,41"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
</vector>
